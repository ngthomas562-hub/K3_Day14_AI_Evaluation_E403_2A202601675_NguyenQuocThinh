# Used only by domain_assistant.py when generating real RAG answers.
# Copy this file to .env, then fill in the keys of ONE provider.
# If GEMINI_API_KEY is set it wins; otherwise OPENAI_API_KEY is used.

# Option A - Google Gemini via the OpenAI-compatible endpoint (no extra package).
# Pin an exact model rather than an alias such as gemini-flash-latest, so the
# benchmark stays reproducible. Every served Gemini model thinks before it
# answers, so GeminiGenerator raises the output budget to 1500 tokens.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.5-flash
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Option B - OpenAI.
# OPENAI_API_KEY=your_openai_api_key_here
# OPENAI_MODEL=gpt-4o-mini
